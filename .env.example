# ==========================================================================
# Media Monitoring — environment template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Everything runs WITHOUT credentials in a safe default mode; adding a
# credential + flipping its flag is all that's needed to go live.
# ==========================================================================

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
# Current-coverage monitoring window: content dated before this is never
# fetched or matched (e-paper editions, dated articles).
MONITOR_SINCE=2026-01-01

# --- Database (SQLite default; Supabase/Postgres via connection string) ---
# Local SQLite (default):
DATABASE_URL=sqlite:///./data/media_monitoring.db
# Supabase (use the Session-pooler string; needs the +psycopg driver prefix):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase (optional; only for a future REST/JS client, NOT the DB link) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Storage (local now; S3/R2 later) ---
STORAGE_DIR=./data/storage

# --- Newspaper module ---
NEWSPAPER_SCRAPE_INTERVAL_MINUTES=30
RESPECT_ROBOTS_TXT=true
# Max NEW article bodies fetched PER SITE per scan (bounds cold-start time;
# already-cached articles are always re-matched, so coverage compounds).
NEWSPAPER_MAX_ARTICLES_PER_SCAN=20
# Limit which sites scan (comma slugs; empty = all): dawn,thenews,tribune,jang,nawaiwaqt,ary,dunya
NEWSPAPER_SITES=
# Keep the scraper browser lean (block images/media, no full-page shots). Leave
# true unless you have plenty of RAM and want image-rich screenshots.
BLOCK_MEDIA_IN_SCANS=true
CAPTURE_FULL_PAGE_SCREENSHOTS=false
# Set false to run the web UI without the background auto-scan scheduler.
SCHEDULER_ENABLED=true

# --- E-paper module (daily print editions) ---
EPAPER_ENABLED=true
# Preferred city edition where a paper prints several: lahore|karachi|islamabad…
EPAPER_CITY=lahore
# Limit which papers fetch (comma slugs; empty = all): dawn,tribune,thenews,jang,express,nawaiwaqt
EPAPER_PAPERS=
# Editions are online by early morning; the scheduler fetches daily at HH:15 PKT.
EPAPER_FETCH_HOUR_PKT=8
# Safety cap per edition (dailies are typically 8-20 pages)
EPAPER_MAX_PAGES=24
# Vision model for reading page scans (empty = LLM_MODEL)
EPAPER_OCR_MODEL=

# --- Vision + LLM provider (e-paper page reading, optional scoring) ---
# Reading IMAGE-ONLY e-paper pages needs a vision key. Which one matters:
#
#   URDU (Nastaliq)  -> GEMINI_API_KEY or ANTHROPIC_API_KEY. Groq's vision model
#                       CANNOT read Nastaliq — measured on live pages, it reads
#                       the masthead, invents a date, then repeats one line
#                       hundreds of times. The reader rejects that output rather
#                       than report fabricated matches, so Urdu image-only
#                       papers are simply skipped when only Groq is set.
#   ENGLISH          -> Groq is fine (and fastest).
#
# Papers with a clickable image-map (Jang, The News, Nawa-i-Waqt) need NO key at
# all: the publisher hands us exact article regions and real text.
#
# Model ids: verify against https://api.groq.com/openai/v1/models before
# changing. llama-4-scout / llama-4-maverick / llama-3.1-8b-instant have all
# been RETIRED and now 404.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# When true + a key present, every mention also gets relevance/sentiment/summary.
ENABLE_LLM_SCORING=false

# --- Notifications ---
# console (default; always logs to data/alerts.log) | whatsapp (adds WhatsApp)
NOTIFIER=console
# WhatsApp (Meta Cloud API). Without these, WhatsApp runs in DRY-RUN (logs payload).
# NOTE: production sending outside the 24h window needs an approved message TEMPLATE.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=            # E.164, e.g. +923001234567

# --- Daily email digest (SMTP; works with SES SMTP, Gmail, Outlook, Mailgun…) ---
# Without SMTP_HOST, the digest is written to data/digests/*.html for preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DIGEST_SENDER=                # e.g. alerts@yourdomain.com
DIGEST_RECIPIENTS=           # comma-separated
DIGEST_HOUR_PKT=7

# --- Keyword results / retention (days) ---
KEYWORD_RESULT_LIMIT=25
KEYWORD_RESULT_RETENTION_DAYS=90
KEYWORD_SEARCH_DAYS=30
RETENTION_SCREENSHOTS_DAYS=90
RETENTION_TRANSCRIPTS_DAYS=365
RETENTION_LOGS_DAYS=730

# --- YouTube bulletin module ---
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
# Same GROQ_API_KEY used for e-paper vision also powers Whisper transcription.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_FALLBACK_MODEL=whisper-large-v3
YOUTUBE_TIMEZONE=Asia/Karachi
# First attempt this many minutes after each bulletin airtime.
YOUTUBE_PROCESS_DELAY_MINUTES=60
YOUTUBE_RETRY_OFFSETS_MINUTES=90,120
YOUTUBE_MISSING_AFTER_MINUTES=180
YOUTUBE_DISCOVERY_WINDOW_MINUTES=90
YOUTUBE_MAX_DURATION_SECONDS=3600
YOUTUBE_TRANSCRIBE_CONCURRENCY=1
# ytdlp = download audio from each discovered bulletin URL, then Groq Whisper
# authorized = broadcaster direct audio URL (falls back to ytdlp if missing)
# stub / metadata_only = discover without Groq spend
YOUTUBE_MEDIA_SOURCE=ytdlp
YOUTUBE_METADATA_ONLY=false
# --- YouTube auth (REQUIRED on cloud hosts like Railway) -------------------
# YouTube blocks audio downloads from datacenter IPs with "Sign in to confirm
# you're not a bot". Give yt-dlp a logged-in session's cookies to pass it.
# Export cookies.txt from a browser logged into YouTube (e.g. the "Get
# cookies.txt LOCALLY" extension), then set ONE of these:
#   base64 of the file (best for a Railway env var — single line):
YOUTUBE_COOKIES_B64=
#   or the raw cookies.txt content (multiline):
YOUTUBE_COOKIES=
#   or a path to the file on the server/volume:
YOUTUBE_COOKIES_FILE=
#   local dev only — read cookies straight from your browser: chrome|firefox|edge
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_MONTHLY_COST_ALERT_USD=40

# --- Google Gemini — REQUIRED for Urdu image-only e-papers ---
# Two jobs, both of which nothing else here can do:
#   1. Reading Urdu Nastaliq print pages (Express Urdu, Jehan Pakistan). Groq
#      cannot; without this key those papers are skipped, not guessed at.
#   2. Precise press-clipping boxes — grounding is Gemini's strength, so the
#      clipper uses it for locate/verify and to outline the matched term.
# FREE key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 'gemini-flash-latest' is an alias to the current Flash model; dated versions
# (e.g. gemini-2.5-flash) get 404'd for newly-created keys.
GEMINI_MODEL=gemini-flash-latest
