# ==========================================================================
# Media Monitoring — environment template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Everything runs WITHOUT credentials in a safe default mode; adding a
# credential + flipping its flag is all that's needed to go live.
# ==========================================================================

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

# --- Database (SQLite default; Supabase/Postgres via connection string) ---
# Local SQLite (default):
DATABASE_URL=sqlite:///./data/media_monitoring.db
# Supabase (use the Session-pooler string; needs the +psycopg driver prefix):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase (optional; only for a future REST/JS client, NOT the DB link) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Storage (local now; S3/R2 later) ---
STORAGE_DIR=./data/storage

# --- Newspaper module ---
NEWSPAPER_SCRAPE_INTERVAL_MINUTES=30
RESPECT_ROBOTS_TXT=true
# Max NEW article bodies fetched PER SITE per scan (bounds cold-start time;
# already-cached articles are always re-matched, so coverage compounds).
NEWSPAPER_MAX_ARTICLES_PER_SCAN=20
# Limit which sites scan (comma slugs; empty = all): dawn,thenews,tribune,jang,nawaiwaqt,ary,dunya
NEWSPAPER_SITES=
# Keep the scraper browser lean (block images/media, no full-page shots). Leave
# true unless you have plenty of RAM and want image-rich screenshots.
BLOCK_MEDIA_IN_SCANS=true
CAPTURE_FULL_PAGE_SCREENSHOTS=false
# Set false to run the web UI without the background auto-scan scheduler.
SCHEDULER_ENABLED=true

# --- E-paper module (daily print editions) ---
EPAPER_ENABLED=true
# Preferred city edition where a paper prints several: lahore|karachi|islamabad…
EPAPER_CITY=lahore
# Limit which papers fetch (comma slugs; empty = all): dawn,tribune,thenews,jang,express,nawaiwaqt
EPAPER_PAPERS=
# Editions are online by early morning; the scheduler fetches daily at HH:15 PKT.
EPAPER_FETCH_HOUR_PKT=8
# Safety cap per edition (dailies are typically 8-20 pages)
EPAPER_MAX_PAGES=24
# Vision model for reading page scans (empty = LLM_MODEL)
EPAPER_OCR_MODEL=

# --- Claude API (e-paper page reading + optional relevance/sentiment scoring) ---
# Reading e-paper pages (incl. Urdu Nastaliq) REQUIRES this key; without it,
# pages are still fetched and browsable, matching starts once the key is set.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# When true + key present, every mention also gets relevance/sentiment/summary.
ENABLE_LLM_SCORING=false

# --- Notifications ---
# console (default; always logs to data/alerts.log) | whatsapp (adds WhatsApp)
NOTIFIER=console
# WhatsApp (Meta Cloud API). Without these, WhatsApp runs in DRY-RUN (logs payload).
# NOTE: production sending outside the 24h window needs an approved message TEMPLATE.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=            # E.164, e.g. +923001234567

# --- Daily email digest (SMTP; works with SES SMTP, Gmail, Outlook, Mailgun…) ---
# Without SMTP_HOST, the digest is written to data/digests/*.html for preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DIGEST_SENDER=                # e.g. alerts@yourdomain.com
DIGEST_RECIPIENTS=           # comma-separated
DIGEST_HOUR_PKT=7

# --- Data retention (days) ---
RETENTION_SCREENSHOTS_DAYS=90
RETENTION_TRANSCRIPTS_DAYS=365
RETENTION_LOGS_DAYS=730
